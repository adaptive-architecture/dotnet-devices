<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library, not a test project. test/Directory.Build.props makes everything under
    test/ an MTP test executable, which this is not: it holds what more than one test
    project needs and has no test of its own. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- It holds no product code. Without this the scanner reads it as main code, and a
      false positive in a fixture fails the quality gate for the whole repository. -->
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>

  <!-- The rasterization harness asserts, so it needs xunit's assertions and nothing else.
    xunit.v3 itself carries the runner and refuses to be referenced by a library; the
    runner, the coverage collector and the mocking library belong to a project that runs
    tests, so test/Directory.Build.props's references are dropped here. -->
  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="coverlet.MTP" />
    <PackageReference Remove="NSubstitute" />
    <PackageReference Remove="NSubstitute.Analyzers.CSharp" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup Condition="'$(CONFIGURATION)' == 'Debug' Or '$(BuildDocFx)' == 'true'">
    <ProjectReference Include="..\..\src\Devices\Devices.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CONFIGURATION)' == 'Release' And '$(BuildDocFx)' != 'true'">
    <PackageReference Include="AdaptArch.Devices" />
  </ItemGroup>

  <!-- The fixture embeds this font rather than naming one, so every engine on every platform
    draws the same glyphs. Rasterization/fonts/README.md says why it is checked in. -->
  <ItemGroup>
    <EmbeddedResource Include="Rasterization\fonts\LiberationSans-Regular.ttf" LogicalName="LiberationSans-Regular.ttf" />
  </ItemGroup>

  <!-- The sample label, embedded rather than copied, so the placement scenario has a page
    genuinely smaller than its media and no test depends on a file beside it at run time.
    It is the same file the samples print, so the two cannot drift. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\Devices.Samples\PrintFiles\document.pdf" LogicalName="document.pdf" />
  </ItemGroup>

</Project>
