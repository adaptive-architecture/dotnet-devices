<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="'$(CONFIGURATION)' == 'Debug' Or '$(BuildDocFx)' == 'true'">
    <ProjectReference Include="..\..\src\Devices\Devices.csproj" />
    <ProjectReference Include="..\..\src\Devices.Pdfium\Devices.Pdfium.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CONFIGURATION)' == 'Release' And '$(BuildDocFx)' != 'true'">
    <PackageReference Include="AdaptArch.Devices" />
    <PackageReference Include="AdaptArch.Devices.Pdfium" />
  </ItemGroup>


  <!-- The rasterization scenarios are one harness run by each engine's own project, so the
    PDFium half runs everywhere and the in-box half runs where that engine exists. -->
  <ItemGroup>
    <Compile Include="..\Shared\Rasterization\*.cs" LinkBase="Rasterization" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\Devices.Samples\PrintFiles\pages.pdf" Link="pages.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
