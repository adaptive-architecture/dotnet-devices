<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key=".nuget" value="./.nuget/" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- The key of each <packageSource> must match a key in <packageSources>. -->
    <!-- Public packages come from nuget.org only. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Our own packages come from the local .nuget folder only. The publish flow fills it. -->
    <packageSource key=".nuget">
      <package pattern="AdaptArch.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>