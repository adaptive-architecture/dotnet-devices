{
   "tasks": [
      {
         "name": "format-staged",
         "group": "pre-commit",
         "command": "dotnetup",
         "args": [ "dotnet", "format", "--include", "${staged}" ],
         "include": [ "**/*.cs" ]
      },
      {
         "name": "restage-formatted",
         "group": "pre-commit",
         "command": "git",
         "args": [ "add", "${staged}" ],
         "include": [ "**/*.cs" ]
      }
   ]
}
