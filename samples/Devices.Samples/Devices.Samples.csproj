<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows builds take the -windows TFM so the AdaptArch.Devices.Windows asset
      resolves; everywhere else the sample stays plain net10.0. One TFM per OS means
      the documented commands need no -f flag anywhere. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <!-- The web SDK sets DebugType to full when nothing else does. The rest of this
      repository builds portable symbols, and publish-samples.sh prunes a .pdb from the
      native AOT folder, so the value is pinned here instead of inherited. -->
    <DebugType>portable</DebugType>
    <!-- The SDK turns the request delegate generator on only for a trimmed or a native AOT
      publish. Turning it on here means an endpoint shape the generator cannot read fails
      an ordinary build, and not the publish at the end of the day. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Devices\Devices.csproj" />
    <ProjectReference Include="..\..\src\Devices.DependencyInjection\Devices.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Devices.Pdfium\Devices.Pdfium.csproj" />
    <ProjectReference Include="..\..\src\Devices.Windows\Devices.Windows.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PrintFiles\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PrintJobs\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The project icon lives once, at the repository root. A Content item that links it
    into wwwroot is copied to bin, but the development server reads wwwroot itself, so the
    file is placed there instead and kept out of source control. -->
  <Target Name="CopyProjectIcon" BeforeTargets="BeforeBuild"
          Inputs="..\..\assets\logo.ico" Outputs="wwwroot\favicon.ico">
    <Copy SourceFiles="..\..\assets\logo.ico" DestinationFiles="wwwroot\favicon.ico" />
  </Target>

</Project>
